# Cuadra — secretos locales. NUNCA versionar (backend/.env está en .gitignore).
# Copia este archivo a .env y rellena los valores.

# Telegram
CUADRA_TELEGRAM_TOKEN=
# 0 = modo dummy (sin red de Telegram); util para pruebas
CUADRA_TELEGRAM_ENABLED=1
CUADRA_PIN=0000

# Userbot (Telethon), identidad por defecto para difusiones y conversaciones.
# api_id/api_hash: https://my.telegram.org -> API development tools.
# La sesion se crea una vez con: python scripts/telegram_login.py
CUADRA_TELETHON_API_ID=12345678
CUADRA_TELETHON_API_HASH=0123456789abcdef0123456789abcdef
CUADRA_TELETHON_PHONE=+5355555555
# CUADRA_TELETHON_SESSION=data/telegram_user
# Scheduler granularity for second-based intervals.
# CUADRA_BROADCAST_TICK_S=5

# LLM (por defecto: llama.cpp propio en 127.0.0.1:8080)
CUADRA_LLM_PROVIDER=openai
CUADRA_LLM_BASE_URL=http://127.0.0.1:8080/v1
CUADRA_LLM_MODEL=Bonsai-8B-Q1_0.gguf

# Desarrollo
CUADRA_DEBUG=1
CUADRA_PORT=8321


