# Cuadra — secretos locales. NUNCA versionar (backend/.env está en .gitignore).
# Copia este archivo a .env y rellena los valores.

# Telegram
CUADRA_TELEGRAM_TOKEN=
CUADRA_PIN=0000

# LLM (por defecto: llama.cpp propio en 127.0.0.1:8080)
CUADRA_LLM_PROVIDER=openai
CUADRA_LLM_BASE_URL=http://127.0.0.1:8080/v1
CUADRA_LLM_MODEL=Bonsai-8B-Q1_0.gguf

# Desarrollo
CUADRA_DEBUG=1
CUADRA_PORT=8321
